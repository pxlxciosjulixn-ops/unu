# ---------------------------------------------------------------------------
# Plantilla de variables de entorno. Copiala a .env y rellena los valores.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# En produccion, el dominio del servicio: unu-api.onrender.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origenes permitidos para CORS, separados por comas y sin slash al final.
# Frontend desplegado: https://unu-3pwh.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# PostgreSQL. Si se deja vacia se usa SQLite local.
# Formato: postgresql://USUARIO:PASSWORD@HOST:5432/BASE?sslmode=require
DATABASE_URL=

# ---------------------------------------------------------------------------
# Modelo del chat. Los dos proveedores hablan el dialecto de OpenAI, asi que
# cambiar de uno a otro es cambiar CHAT_PROVIDER.
# ---------------------------------------------------------------------------
CHAT_PROVIDER=openai

# OpenAI (mas rapido: el primer token llega en ~2 s).
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# NVIDIA NIM (gratis, pero con colas: se han medido esperas de mas de 100 s).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=moonshotai/kimi-k3
# Esfuerzo de razonamiento de Kimi: low, high o max. Mas esfuerzo es mas espera.
NVIDIA_REASONING_EFFORT=low

# Comunes a los dos.
CHAT_MAX_TOKENS=4096
CHAT_TEMPERATURE=0.7
