# ---------------------------------------------------------------------------
# Plantilla de variables de entorno. Copiala a .env y rellena los valores.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origenes permitidos para CORS (el frontend de Vite).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# PostgreSQL. Si se deja vacia se usa SQLite local.
# Formato: postgresql://USUARIO:PASSWORD@HOST:5432/BASE?sslmode=require
DATABASE_URL=

# NVIDIA NIM (DeepSeek).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731

# ---------------------------------------------------------------------------
# Solo en produccion (Render). En local no hace falta tocarlas.
# ---------------------------------------------------------------------------

# Con DEBUG=False el proyecto exige DJANGO_SECRET_KEY y activa redirect a
# HTTPS, cookies seguras y HSTS.
# DJANGO_DEBUG=False

# Hilos y procesos de gunicorn. El chat mantiene la conexion abierta mientras
# el modelo responde, por eso varios hilos por proceso.
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=8
# GUNICORN_TIMEOUT=300

# El contenedor migra al arrancar. Ponlo en 0 si prefieres migrar aparte.
# RUN_MIGRATIONS=1

# Siembra los datos de prueba del dashboard al arrancar. Ojo: usa --reset, o
# sea que borra los datos que ya esten. Activalo una vez y vuelvelo a apagar.
# SEED_DASHBOARD=0

# HSTS: un ano por defecto. Solo activa los de abajo si TODO el dominio
# (incluidos los subdominios) va por HTTPS.
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_HSTS_PRELOAD=False
