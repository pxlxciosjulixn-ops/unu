# ---------------------------------------------------------------------------
# Plantilla de variables del frontend.
#
#   .env.local       -> desarrollo (`npm run dev`). No se sube.
#   .env.production  -> build (`npm run build`). Sí se sube, no lleva secretos.
#
# Todo lo que empiece por VITE_ termina dentro del bundle que descarga el
# navegador: nunca pongas aquí llaves de API ni contraseñas.
# ---------------------------------------------------------------------------

# URL del backend, sin slash al final.
#   local:      http://127.0.0.1:8000
#   desplegado: https://unu-api.onrender.com
VITE_API_URL=http://127.0.0.1:8000
