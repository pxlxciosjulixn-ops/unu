# Variables del build de producción. Vite las toma automáticamente al correr
# `npm run build`, así que no hay que configurar nada en el panel de Render.
#
# Este archivo SÍ va al repo: no tiene secretos. Todo lo que empiece por VITE_
# queda dentro del JavaScript que descarga el navegador, así que aquí nunca se
# ponen llaves ni contraseñas.

# API del backend desplegado en Render (sin slash al final).
VITE_API_URL=https://unu-api.onrender.com
